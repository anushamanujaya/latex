# Set these in the backend Vercel project's Preview environment; never commit real values.
NODE_ENV=production
MONGODB_URI=mongodb+srv://<staging-user>:<url-encoded-password>@<atlas-host>/<staging-database>?retryWrites=true&w=majority
JWT_SECRET=<at-least-32-random-characters>
WEB_ORIGIN=https://<staging-frontend-domain>
COOKIE_SECURE=true
# Use lax only for sibling HTTPS domains; separate vercel.app sites need none and browser verification.
COOKIE_SAME_SITE=none
MONGODB_MAX_POOL_SIZE=10
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000
